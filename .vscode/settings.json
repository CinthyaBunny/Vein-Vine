{
  // Pin the solution explicitly. Without this the C# extension scans the
  // folder and may latch onto a stray scaffold project rather than this one -
  // the original was a copy under "Helpful Data" targeting an SDK you don't
  // have installed (Dalamud.NET.Sdk 12.0.2), which filled the Problems panel
  // with restore errors that looked like they came from the real project.
  "dotnet.defaultSolution": "Gleaner.sln",

  // The stale scaffold is reference material, not code to be indexed.
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "Helpful Data/_original_scaffold": true
  },
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true
  },

  "[csharp]": {
    "editor.formatOnSave": true
  }
}
