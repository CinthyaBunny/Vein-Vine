{
  // Pin the solution explicitly. Without this the C# extension scans the
  // folder and may latch onto Helpful Data/_original_scaffold/VeinAndVine.csproj,
  // which targets an SDK you don't have installed (Dalamud.NET.Sdk 12.0.2) and
  // will fill the Problems panel with restore errors that look like they're
  // coming from the real project.
  "dotnet.defaultSolution": "VeinAndVine.sln",

  // The stale scaffold is reference material, not code to be indexed.
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "Helpful Data/_original_scaffold": true
  },
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true
  },

  "[csharp]": {
    "editor.formatOnSave": true
  }
}
