{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Debug build. Unload the dev plugin first or the DLL stays locked.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/VeinAndVine.sln",
        "-c",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build release",
      "detail": "Release build. Also produces bin/x64/Release/VeinAndVine/latest.zip.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/VeinAndVine.sln",
        "-c",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "clean",
      "detail": "Removes bin/ and obj/. Fixes most 'file is locked' and stale-build weirdness.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/VeinAndVine.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
